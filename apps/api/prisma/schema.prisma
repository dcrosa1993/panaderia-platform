generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum EstimationMode {
  PRODUCT_COUNT
  FLOUR_QUANTITY
}

enum MeasurementDimension {
  MASS
  VOLUME
  COUNT
}

enum RecipeVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

model User {
  id           String @id @default(cuid())
  fullName     String @db.VarChar(120)
  email        String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(255)

  memberships        Membership[]
  createdEstimations Estimation[] @relation("EstimationCreatedBy")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model Business {
  id           String @id @default(cuid())
  name         String @db.VarChar(160)
  currencyCode String @default("CUP") @db.VarChar(3)

  memberships Membership[]
  ingredients Ingredient[]
  products    Product[]
  estimations Estimation[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("businesses")
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole @default(MEMBER)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

model MeasurementUnit {
  id           String               @id @default(cuid())
  code         String               @unique @db.VarChar(20)
  name         String               @db.VarChar(80)
  symbol       String               @db.VarChar(12)
  dimension    MeasurementDimension
  factorToBase Decimal              @db.Decimal(20, 8)
  isBase       Boolean              @default(false)
  isActive     Boolean              @default(true)

  baseIngredients          Ingredient[]      @relation("IngredientBaseUnit")
  purchasePrices           IngredientPrice[] @relation("IngredientPurchaseUnit")
  productsByProductionUnit Product[]         @relation("ProductProductionUnit")
  productsByTargetWeight   Product[]         @relation("ProductTargetWeightUnit")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([dimension, isActive])
  @@map("measurement_units")
}

model Ingredient {
  id                String   @id @default(cuid())
  businessId        String
  name              String   @db.VarChar(160)
  normalizedName    String   @db.VarChar(160)
  description       String?  @db.VarChar(500)
  baseUnitId        String
  densityGramsPerMl Decimal? @db.Decimal(12, 6)
  isActive          Boolean  @default(true)

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  baseUnit    MeasurementUnit    @relation("IngredientBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  prices      IngredientPrice[]
  recipeLines RecipeIngredient[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([businessId, normalizedName])
  @@index([businessId, isActive])
  @@map("ingredients")
}

model IngredientPrice {
  id               String   @id @default(cuid())
  ingredientId     String
  purchaseQuantity Decimal  @db.Decimal(18, 6)
  purchaseUnitId   String
  totalPrice       Decimal  @db.Decimal(18, 4)
  effectiveFrom    DateTime @default(now()) @db.Timestamptz(3)

  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  purchaseUnit MeasurementUnit @relation("IngredientPurchaseUnit", fields: [purchaseUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([ingredientId, effectiveFrom])
  @@map("ingredient_prices")
}

model Product {
  id                   String   @id @default(cuid())
  businessId           String
  name                 String   @db.VarChar(160)
  normalizedName       String   @db.VarChar(160)
  description          String?  @db.VarChar(500)
  productionUnitId     String
  targetFinishedWeight Decimal? @db.Decimal(18, 6)
  targetWeightUnitId   String?
  isActive             Boolean  @default(true)

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productionUnit   MeasurementUnit  @relation("ProductProductionUnit", fields: [productionUnitId], references: [id], onDelete: Restrict)
  targetWeightUnit MeasurementUnit? @relation("ProductTargetWeightUnit", fields: [targetWeightUnitId], references: [id], onDelete: Restrict)
  recipeVersions   RecipeVersion[]
  estimations      Estimation[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([businessId, normalizedName])
  @@index([businessId, isActive])
  @@map("products")
}

model RecipeVersion {
  id                      String              @id @default(cuid())
  productId               String
  versionNumber           Int
  status                  RecipeVersionStatus @default(DRAFT)
  expectedBakeLossPercent Decimal             @db.Decimal(7, 4)
  notes                   String?             @db.VarChar(1000)
  publishedAt             DateTime?           @db.Timestamptz(3)

  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  ingredients RecipeIngredient[]
  estimations Estimation[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, versionNumber])
  @@index([productId, status])
  @@map("recipe_versions")
}

model RecipeIngredient {
  id              String  @id @default(cuid())
  recipeVersionId String
  ingredientId    String
  bakerPercentage Decimal @db.Decimal(9, 4)
  isFlourBase     Boolean @default(false)
  sortOrder       Int     @default(0)

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeVersionId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model Estimation {
  id                   String @id @default(cuid())
  businessId           String
  productId            String
  recipeVersionId      String
  createdByUserId      String
  currencyCodeSnapshot String @default("CUP") @db.VarChar(3)

  mode EstimationMode

  // Identidad histórica del producto y de la receta utilizada.
  productNameSnapshot               String
  productProductionUnitCodeSnapshot String
  recipeVersionNumber               Int

  // Parámetros de entrada para el cálculo por piezas.
  plannedProductCount                  Int?
  targetFinishedWeightInput            Decimal? @db.Decimal(20, 8)
  targetFinishedWeightUnitCode         String?
  targetFinishedWeightUnitName         String?
  targetFinishedWeightUnitSymbol       String?
  targetFinishedWeightUnitFactorToBase Decimal? @db.Decimal(20, 8)

  // Parámetros de entrada para el cálculo por harina.
  flourQuantity         Decimal? @db.Decimal(20, 8)
  flourUnitCode         String?
  flourUnitName         String?
  flourUnitSymbol       String?
  flourUnitFactorToBase Decimal? @db.Decimal(20, 8)

  // Parámetros y resultados congelados.
  expectedBakeLossPercent   Decimal @db.Decimal(7, 4)
  recipeTotalPercentage     Decimal @db.Decimal(12, 6)
  flourMassGrams            Decimal @db.Decimal(20, 8)
  rawDoughMassGrams         Decimal @db.Decimal(20, 8)
  expectedFinishedMassGrams Decimal @db.Decimal(20, 8)

  targetFinishedWeightPerUnitGrams Decimal? @db.Decimal(20, 8)
  theoreticalProductCount          Decimal? @db.Decimal(20, 8)
  wholeProductCount                Int?

  // Costes de los ingredientes.
  costingComplete             Boolean
  estimatedIngredientCost     Decimal? @db.Decimal(20, 8)
  knownIngredientCostSubtotal Decimal  @db.Decimal(20, 8)

  // Costes adicionales del lote, en la moneda del negocio.
  laborCost     Decimal? @db.Decimal(20, 8)
  energyCost    Decimal? @db.Decimal(20, 8)
  packagingCost Decimal? @db.Decimal(20, 8)
  otherCost     Decimal? @db.Decimal(20, 8)

  // Subtotales y coste final de producción.
  additionalCostsSubtotal Decimal? @db.Decimal(20, 8)
  knownCostSubtotal       Decimal? @db.Decimal(20, 8)
  productionCostTotal     Decimal? @db.Decimal(20, 8)

  // Supuestos financieros empleados.
  targetMarginPercent Decimal? @db.Decimal(7, 4)
  salesTaxRatePercent Decimal? @db.Decimal(7, 4)

  // Resultados financieros del lote completo.
  suggestedNetSalesTotal      Decimal? @db.Decimal(20, 8)
  targetProfitTotal           Decimal? @db.Decimal(20, 8)
  salesTaxTotal               Decimal? @db.Decimal(20, 8)
  suggestedCustomerSalesTotal Decimal? @db.Decimal(20, 8)

  // Resultados por unidad vendible, cuando se conoce el rendimiento.
  productionCostPerUnit      Decimal? @db.Decimal(20, 8)
  suggestedNetUnitPrice      Decimal? @db.Decimal(20, 8)
  targetProfitPerUnit        Decimal? @db.Decimal(20, 8)
  salesTaxPerUnit            Decimal? @db.Decimal(20, 8)
  suggestedCustomerUnitPrice Decimal? @db.Decimal(20, 8)

  missingPriceIngredientNames Json

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)

  createdBy User @relation("EstimationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  ingredients EstimationIngredient[]

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
  @@index([recipeVersionId])
  @@index([createdByUserId])
}

model EstimationIngredient {
  id           String @id @default(cuid())
  estimationId String

  // ID de origen informativo, sin FK hacia el ingrediente actual.
  sourceIngredientId String
  nameSnapshot       String

  bakerPercentage Decimal @db.Decimal(12, 6)
  isFlourBase     Boolean
  sortOrder       Int

  // Unidad base y densidad tal como se utilizaron en ese momento.
  baseUnitCode         String
  baseUnitName         String
  baseUnitSymbol       String
  baseUnitDimension    String
  baseUnitFactorToBase Decimal  @db.Decimal(20, 8)
  densityGramsPerMl    Decimal? @db.Decimal(20, 8)

  // Cantidades calculadas.
  ingredientMassGrams Decimal  @db.Decimal(20, 8)
  ingredientVolumeMl  Decimal? @db.Decimal(20, 8)
  quantityInBaseUnit  Decimal  @db.Decimal(20, 8)

  // Instantánea del precio de compra.
  purchaseQuantity         Decimal? @db.Decimal(20, 8)
  purchaseUnitCode         String?
  purchaseUnitName         String?
  purchaseUnitSymbol       String?
  purchaseUnitDimension    String?
  purchaseUnitFactorToBase Decimal? @db.Decimal(20, 8)
  purchaseTotalPrice       Decimal? @db.Decimal(20, 8)

  estimatedCost Decimal? @db.Decimal(20, 8)

  estimation Estimation @relation(fields: [estimationId], references: [id], onDelete: Cascade)

  @@index([estimationId, sortOrder])
}
