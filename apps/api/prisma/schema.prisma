
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MeasurementDimension {
  MASS
  VOLUME
  COUNT
}

enum RecipeVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

model User {
  id           String       @id @default(cuid())
  fullName     String       @db.VarChar(120)
  email        String       @unique @db.VarChar(254)
  passwordHash String       @db.VarChar(255)

  memberships  Membership[]

  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model Business {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(160)

  memberships  Membership[]
  ingredients  Ingredient[]
  products Product[]

  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  @@map("businesses")
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  businessId  String
  role        MembershipRole @default(MEMBER)

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}


model MeasurementUnit {
  id             String               @id @default(cuid())
  code           String               @unique @db.VarChar(20)
  name           String               @db.VarChar(80)
  symbol         String               @db.VarChar(12)
  dimension      MeasurementDimension
  factorToBase   Decimal              @db.Decimal(20, 8)
  isBase         Boolean              @default(false)
  isActive       Boolean              @default(true)

  baseIngredients Ingredient[]        @relation("IngredientBaseUnit")
  purchasePrices  IngredientPrice[]   @relation("IngredientPurchaseUnit")
  productsByProductionUnit Product[] @relation("ProductProductionUnit")
  productsByTargetWeight   Product[] @relation("ProductTargetWeightUnit")

  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  @@index([dimension, isActive])
  @@map("measurement_units")
}

model Ingredient {
  id             String             @id @default(cuid())
  businessId     String
  name           String             @db.VarChar(160)
  normalizedName String             @db.VarChar(160)
  description    String?            @db.VarChar(500)
  baseUnitId     String
  densityGramsPerMl Decimal? @db.Decimal(12, 6)
  isActive       Boolean            @default(true)

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  baseUnit       MeasurementUnit    @relation("IngredientBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  prices         IngredientPrice[]
  recipeLines    RecipeIngredient[]

  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([businessId, normalizedName])
  @@index([businessId, isActive])
  @@map("ingredients")
}

model IngredientPrice {
  id              String           @id @default(cuid())
  ingredientId    String
  purchaseQuantity Decimal         @db.Decimal(18, 6)
  purchaseUnitId  String
  totalPrice      Decimal          @db.Decimal(18, 4)
  effectiveFrom   DateTime         @default(now()) @db.Timestamptz(3)

  ingredient      Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  purchaseUnit    MeasurementUnit  @relation("IngredientPurchaseUnit", fields: [purchaseUnitId], references: [id], onDelete: Restrict)

  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  @@index([ingredientId, effectiveFrom])
  @@map("ingredient_prices")
}


model Product {
  id                   String          @id @default(cuid())
  businessId           String
  name                 String          @db.VarChar(160)
  normalizedName       String          @db.VarChar(160)
  description          String?         @db.VarChar(500)
  productionUnitId     String
  targetFinishedWeight Decimal?        @db.Decimal(18, 6)
  targetWeightUnitId   String?
  isActive             Boolean         @default(true)

  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productionUnit       MeasurementUnit @relation("ProductProductionUnit", fields: [productionUnitId], references: [id], onDelete: Restrict)
  targetWeightUnit     MeasurementUnit? @relation("ProductTargetWeightUnit", fields: [targetWeightUnitId], references: [id], onDelete: Restrict)
  recipeVersions RecipeVersion[]

  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([businessId, normalizedName])
  @@index([businessId, isActive])
  @@map("products")
}


model RecipeVersion {
  id                     String              @id @default(cuid())
  productId              String
  versionNumber          Int
  status                 RecipeVersionStatus @default(DRAFT)
  expectedBakeLossPercent Decimal             @db.Decimal(7, 4)
  notes                  String?             @db.VarChar(1000)
  publishedAt            DateTime?           @db.Timestamptz(3)

  product                Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  ingredients            RecipeIngredient[]

  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([productId, versionNumber])
  @@index([productId, status])
  @@map("recipe_versions")
}

model RecipeIngredient {
  id              String        @id @default(cuid())
  recipeVersionId String
  ingredientId    String
  bakerPercentage Decimal       @db.Decimal(9, 4)
  isFlourBase     Boolean       @default(false)
  sortOrder       Int           @default(0)

  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeVersionId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}
